{
  "name": "agproapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AG Pro Solutions - edge-native business management (CRM, inventory, pricing, invoicing, checkwriting)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "react-router build",
    "preview": "vite preview",
    "deploy": "react-router build && wrangler d1 migrations apply agpro-db --remote && wrangler deploy",
    "migrate:check": "wrangler d1 migrations list agpro-db --remote",
    "typegen": "react-router typegen",
    "typecheck": "react-router typegen && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "react-router build && node scripts/smoke.mjs",
    "types": "wrangler types",
    "user:create": "node scripts/create-user.mjs",
    "import:prices": "node scripts/import-prices.mjs",
    "audit:archive": "node scripts/audit-archive.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply agpro-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply agpro-db --remote",
    "db:studio": "drizzle-kit studio",
    "db:seed:local": "wrangler d1 execute agpro-db --local --file=./seed/0001_reference.sql && wrangler d1 execute agpro-db --local --file=./seed/0002_units.sql",
    "db:seed:remote": "wrangler d1 execute agpro-db --remote --file=./seed/0001_reference.sql && wrangler d1 execute agpro-db --remote --file=./seed/0002_units.sql"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "isbot": "^5.2.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.11",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@react-router/dev": "^8.4.0",
    "@react-router/node": "^8.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
