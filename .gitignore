# ── Local / seeded source documents (never commit) ────────────────────────────
# Scanned vendor invoices, BOLs and inventory workbooks live in docs/ for local
# ingestion only. They contain vendor pricing and customer data.
docs/*.jpg
docs/*.jpeg
docs/*.png
docs/*.pdf
docs/*.xlsx
docs/*.xls
# CSV exports of the price sheets: vendor costs are commercially sensitive.
docs/csv/
docs/*.csv

# Audit archives contain actor IPs and change history.
docs/archive/

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Cloudflare / Wrangler ────────────────────────────────────────────────────
.wrangler/
.wrangler-dist/
wrangler.toml.bak
.dev.vars
.dev.vars.*
!.dev.vars.example

# ── Build output ─────────────────────────────────────────────────────────────
dist/
build/
.output/
.vercel/
*.tsbuildinfo

# React Router generated route types (recreated by `pnpm typegen`)
.react-router/

# ── Environment ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
.vars

# ── Editor / OS ──────────────────────────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# ── Logs / coverage ──────────────────────────────────────────────────────────
*.log
npm-debug.log*
pnpm-debug.log*
coverage/
