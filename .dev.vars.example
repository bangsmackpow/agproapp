# Copy to `.dev.vars` for local development: `cp .dev.vars.example .dev.vars`
# `.dev.vars` is gitignored. Never commit real secrets.

# Overrides the deployed `ENVIRONMENT = "production"` from wrangler.toml, so
# session cookies are not marked Secure over plain http://localhost.
ENVIRONMENT=development

# ── Outgoing invoice mail (optional) ─────────────────────────────────────────
# Without a key, delivery is recorded but not transmitted, and the app says so
# rather than pretending the email was sent.
# MAIL_PROVIDER_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Overrides the MAIL_FROM / MAIL_REPLY_TO vars from wrangler.toml locally.
# MAIL_FROM="AG Pro Solutions <invoices@example.com>"

# ── Drizzle Kit remote access (optional, for db:studio / push) ───────────────
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
CLOUDFLARE_D1_TOKEN=

# ── Outbound invoice delivery (Phase 4) ──────────────────────────────────────
# MAIL_FROM=invoices@agpro.example
# MAIL_PROVIDER_API_KEY=
